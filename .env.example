# ---------- MySQL-реплика (источник) ----------
DB_HOST=mysql-replica.example.local
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=cods

# Имя схемы источника в MySQL-реплике
SOURCE_SCHEMA=mysql_replica

# ---------- PostgreSQL (приёмник / мини-DWH) ----------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=retail_dwh
PG_USER=postgres
PG_PASSWORD=postgres

# ---------- Режимы ----------
USE_POSTGRES=true

# ---------- SQLite (legacy, для локальных экспериментов) ----------
SQLITE_DB=retail_local.db